# 可选：Langfuse LLM 调用追踪（仅当 LANGFUSE_ENABLE=true 时生效）
langfuse:
  enable: "${LANGFUSE_ENABLE:false}"
  public_key: "${LANGFUSE_PUBLIC_KEY:}"
  secret_key: "${LANGFUSE_SECRET_KEY:}"
  base_url: "${LANGFUSE_BASE_URL:http://localhost:3000}"

llm:
  api_key: "${LLM_API_KEY}"
  base_url: "${LLM_BASE_URL:https://api.deepseek.com}"
  model: "${LLM_MODEL:deepseek-chat}"
  # proxy_url: "${LLM_PROXY_URL:}"  # 可选：HTTP 代理
  # 直连调用点绑定 response_format=json_object（端点支持 json_object，不支持 json_schema/strict）
  structured_json: "${LLM_STRUCTURED_JSON:true}"

web_search:
  tavily:
    api_key: "${TAVILY_API_KEY:}"
    base_url: "https://api.tavily.com"
    # proxy_url: "http://proxy.example.com:7890"
    timeout: 15.0
    max_results: 6
  ddgs:
    # proxy_url: "http://proxy.example.com:7890"
    timeout: 20
    region: "cn-zh"
    max_results: 6

tushare:
  api_key: "${TUSHARE_TOKEN:}"

data:
  root_dir: "${DATA_ROOT:data}"

# 研究连续体 P1（W3）：财报原文窗口（docs/design/RESEARCH_CONTINUUM_DESIGN.md §15.1-F）
# 从**本地已解析**的财报（reports/ + reports_full/）中选出叙事章节（管理层讨论 / 主营业务 /
# 风险），喂给 midterm 的证据抽取；纯规则、无网络、无 LLM，取不到时只记 D1 issue 不中断 run。
# 本段带默认值 ⇒ 整段省略即取内置默认；`enabled: false` 是回滚开关（完全回到"只喂冲突解释"）。
# **行为变更登记**：`enabled: true` 改变了 run 的可观测面（新增 D1 窗口 issue / 窗口内容变化），
# 按 §15.1-F 须登记进 docs/roadmap/ROADMAP.md「行为变更登记」。
report_window:
  enabled: true          # false ⇒ 完全回到现状（只喂已验证冲突解释，不新增任何 issue）
  max_chars: 12000       # 窗口字符预算（约 8k token 量级）
  max_sections: 12       # 窗口章节数预算（超出即标记 truncated）
  reports_root: null     # null ⇒ report_parser.reports_root() 默认（<PROJECT_ROOT>/reports）

# 偏离控制框架（docs/design/DEVIATION_CONTROL_FRAMEWORK.md §14.6）
# 五段全部带默认值 ⇒ 本段可以整段省略（缺段时各读取点 fail-open 取内置默认，import 期不读配置）。
# 此处显式列出便于运维调整与回滚；数值与 alphabee.config.DeviationSettings() 的默认值逐项一致
# （由测试程序化比对，防"文档写一套、代码是另一套"的漂移）。
# 公司赛道：对标组候选判定质量闸（判定 C）与独立 batch judge（判定 D）。
# 权重/阈值的唯一处在 alphabee/company_track/peer_judge.py 的默认常量，本段用于覆盖；
# 整段缺省时全部取默认值（旧 config 仍可 import，行为不变）。
# 阈值口径（设计 §8 决策 3）：**由标注集 train 段标定**，生产生效阈值 = 标定点
#（占位默认 0.50/0.30/0.20 在 holdout 上不成立，只是 sweep 起点；敏感性表见评测报告）。
company_track:
  peer_quality:
    enabled: true               # 候选质量闸总开关：false ⇒ 本闸**不做任何剔除**（全部候选直接保留，含
                                # verdict=reject 与低分/缺分候选），仅在对标组 notes 记一行「质量闸已停用」；
                                # 分数与维度仍照常记录。只门控本闸，不影响 min_peers 消费侧闸、分类学开关
                                # （taxonomy_enabled）与置信度三档。回滚 = 该键置 false。
    # 阈值来源：标注集 **train 段**标定；现行值 = 上一版 train 标定点（0.40/0.20/0.20，即"生产生效点"）。
    # 判定 D 接通后本版在 train 段重标定得到 0.40/0.40/0.10，但相对现行点 train F1 仅 +0.004（噪声级）
    # 而 holdout 明显下降（0.608 < 0.685）⇒ **不采纳**新点、保留现行生产点（待样本扩大后重标定）；
    # 占位默认 0.50/0.30/0.20 不生效（仅作 sweep 起点）。逐点对照表见
    # outputs/peer_group_eval.md 的 DoD「阈值点对照」章节。
    min_overlap: 0.40           # 合成 overlap 下限（overlap = Σ w_i·dim_i；由 train 段标定）
    weights: {product: 0.40, customer: 0.30, business_model: 0.20, material_tech: 0.10}
    product_floor: 0.20         # product 维度下限（由 train 段标定）
    customer_floor: 0.20        # customer 维度下限
    residual_l3_min_constituents: 15   # 残差桶判定：L3 成分数不足 ⇒ 分类学不可信
    taxonomy_enabled: true      # 分类学（判定 E）：同 L3/（残差桶时）同 L2 成分作召回池 + 特征注入。
                                # 只作召回与提示，**绝不硬闸**；回滚方式 = 该键置 false
                                # （不读快照、不并入召回池、不注入 same_l3/same_l2、置信度按缺失信号）。
    judge_enabled: false        # 独立 batch judge（与生成同模型，无独立模型配置项）。
                                # 默认 false（= 判定 C 口径）：评测 DoD 为负结果——F1 判据在标定点/
                                # 生产生效点成立（0.702 ≥ 0.685），但稳定性判据不成立（保留集 Jaccard
                                # 相对生成器口径 train/holdout/all 三段均略降 −0.009~−0.025）
                                # ⇒ 按设计 §6 Step 2 不默认启用；置 true 即启用（复核见
                                # outputs/peer_group_eval.md 的 DoD 章节）。
                                # judge 失败/超时/非 JSON/漏判 ⇒ fail-open：回退生成器分、
                                # 记 judge_degraded，**不置** no_peers（可重试）
    judge_batch_size: 20        # judge 单批候选数上限（超出按批切分调用）
    min_peers: 2                # 消费侧最小对标数：低于该值不注入 peer_*、回退 industry
    confidence:                 # 对标组置信度（确定性合成，不额外调 LLM；缺失信号按 0 处理）
      low: 0.4                  # score < low ⇒ 低（报告显式提示基准参考性弱）
      medium: 0.7               # score < medium ⇒ 中；否则高
      weights: {taxonomy_reliable: 0.4, judge_direct_ratio: 0.3, mean_overlap: 0.3}   # 和 = 1

deviation:
  detection:                 # §6 即时检测（F1：with_deviation_detection 包装器读这里）
    enabled: true            # 检测器总开关：关闭 ⇒ 整层 no-op（回滚用，不影响业务节点行为）
    llm_detectors: false     # v1 恒 false（§16 反模式：不做 LLM 检测器）

  budget:                    # §10 偏离预算：恢复阶梯的直接升级判据
    severity_weight:         # §10.1 代价敞口权重（severity → 权重）
      low: 1
      medium: 3
      high: 10
      critical: 30
    cost_exposure_threshold: 30   # 代价敞口 **超过**该值 ⇒ 直跳 Tier 5（越过中间档）
    d_max:                   # §14.6 / §10.2 每任务类型的偏离预算 D_max = §11.1「预算消耗 = D_cum / D_max」的分母
      analysis: 60           # 分析场景（run.context 无 task_kind 时的缺省键）
      tracking: 20           # 宏观环跟踪场景（run.context['task_kind'] = 'tracking'）
                             # 缺失/非正/不可解析 ⇒ budget_consumption 为 None（绝不回退 0，§14.5-B）

  ledger:                    # §5.2 跨 run 偏离账本（fail-open：写失败只 warning，绝不打断 run）
    enabled: true            # 账本写入总开关：关闭 ⇒ 只记 Step、不落库
    fingerprint_normalize: true  # 指纹是否先归一化数字/路径（降重时报同一偏离）
    retention_days: 365      # 账本保留天数（purge_before 用）

  amplification:             # §8 放大审计（F3 使用）
    audit_enabled: true      # 是否执行 audit_amplification（关闭 ⇒ 不做加权边方向一致性审计）
    overturn_severity: high  # 方向不一致时的上报严重度

  recovery:                  # §7 恢复阶梯协议化（F2 使用）
    enabled: true            # 是否启用统一阶梯裁决；**关闭 ⇒ 回落 pre-F2 基线判据**（§14.8 回滚方式）

  # ── 研究连续体 P2（D2-B2）：跟踪阈值 + 入口前置校验（docs/design/RESEARCH_CONTINUUM_DESIGN.md §15.2-D / §15.7）──
  # 本段**此前不存在**：`tracking/triggers.py::thresholds_from_settings()` 一直 fail-open 回落中试默认。
  # 本段落地后除 block_stale_runs 为**新增行为**外，其余四键均为**既有默认的显式登记（有效判定不变）**：
  # stale_after_days == tracking.scheduler.DEFAULT_STALE_AFTER_DAYS；tv_distance == midterm.diff_consumers._TV_TRIGGER
  # （落地后 monitor_kwargs() 由"不传参"变为显式传 tv_threshold=0.3，而 monitor_triggers 的默认值就是同一常量）；
  # evidence_rate == _EVIDENCE_RATE_TRIGGER（当前无读取点）；max_alerts_shown 只服务 --track-alerts 只读视图。
  # **行为变更登记**：block_stale_runs=true 会在该标的最新帧陈旧/存在未消费触发时阻断 CLI 交互分析请求
  # （SystemExit(3)；--allow-stale 显式放行，且放行后仍由 collect_raw_facts 记账），见
  # docs/roadmap/ROADMAP.md「行为变更登记」P2 行。整段省略 ⇒ 取内置默认（本段即默认值）。
  tracking:
    stale_after_days: 7      # 帧保鲜期（天）：stale_after 到期即陈旧（显式登记既有默认）
    block_stale_runs: true   # 入口是否阻断（false = 只记录不阻断：§15.2-E 的回滚方式之一）
    tv_distance: 0.3         # 信念位移阈值（显式登记既有默认，== _TV_TRIGGER）
    evidence_rate: 0.5       # 证据到达率阈值（显式登记既有默认，== _EVIDENCE_RATE_TRIGGER）
    max_alerts_shown: 20     # --track-alerts 每标的显示的最大告警帧数（只读视图）
